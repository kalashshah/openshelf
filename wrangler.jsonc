{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openshelf",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  // `wrangler d1 create openshelf` and paste the id it prints.
  "d1_databases": [{ "binding": "DB", "database_name": "openshelf", "database_id": "21cf63c6-6172-4bbd-beda-a6d6692b64c6" }],
  // Store-agent questions and AI imports per caller (they spend model tokens).
  "ratelimits": [{ "name": "ASK_LIMIT", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } }],
  "vars": {
    // Cookies, PayPal return URLs and webhooks are issued for this origin. Change it to yours.
    "PUBLIC_URL": "https://openshelf.keronlabs.com"
  },
  // Secrets (`pnpm run secrets` pushes .dev.vars): BETTER_AUTH_SECRET MASTER_KEY OPENAI_API_KEY
  // DEMO_PAYPAL_CLIENT_ID DEMO_PAYPAL_CLIENT_SECRET [DEMO_PAYPAL_WEBHOOK_ID] PAYPAL_LOGIN_CLIENT_ID PAYPAL_LOGIN_CLIENT_SECRET [PAYPAL_LOGIN_ENV]
  // workers.dev stays on for existing webhooks and agent connectors; pages redirect to the domain.
  "workers_dev": true,
  "routes": [{ "pattern": "openshelf.keronlabs.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
