# Copy to .dev.vars for `wrangler dev`; `pnpm run secrets` pushes the same to production.
# Generate the first two: openssl rand -hex 32  /  openssl rand -base64 32
BETTER_AUTH_SECRET=
MASTER_KEY=
# The store agent and the AI importer (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=
# A sandbox PayPal app (developer.paypal.com → Apps & Credentials) that demo stores check out through.
DEMO_PAYPAL_CLIENT_ID=
DEMO_PAYPAL_CLIENT_SECRET=
# Optional: a webhook on that app pointing at <PUBLIC_URL>/webhooks/paypal/demo, so its signatures verify.
DEMO_PAYPAL_WEBHOOK_ID=
# Log in with PayPal: an app with that feature on, email + name attributes ticked,
# and <PUBLIC_URL>/api/auth/callback/paypal as a return URL. Can be the same app as above.
PAYPAL_LOGIN_CLIENT_ID=
PAYPAL_LOGIN_CLIENT_SECRET=
PAYPAL_LOGIN_ENV=sandbox
# Local only
PUBLIC_URL=http://localhost:8787
WEBHOOK_VERIFY=
